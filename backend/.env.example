# Copy to backend/.env and adjust. No third-party API keys are needed.

# MongoDB connection. Use mongomock:// for an in-memory dev database (demo users auto-seeded).
MONGO_URI=mongodb://localhost:27017/
DB_NAME=health_record_system

# Secret used to sign login tokens. REQUIRED for real use: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is generated per run (everyone is signed out on restart).
JWT_SECRET=
JWT_EXP_HOURS=1

# Browser origins allowed to call the API directly (the Vite dev server proxies /api, so this is optional).
CORS_ORIGINS=http://localhost:3000
PORT=5000
